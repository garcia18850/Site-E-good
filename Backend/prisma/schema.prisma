generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  simulations Simulation[]
}

model Company {
  id        String   @id @default(uuid())
  tradeName String
  document  String   @unique // CNPJ
  email     String   @unique
  password  String
  type      String   // Ex: 'SOLAR_INSTALLER', 'DEALERSHIP'
  createdAt DateTime @default(now())
  simulations Simulation[]
}

model Simulation {
  id              String   @id @default(uuid())
  evModel         String
  combustionModel String
  savings         Float
  solarPowerReq   Float?
  userId          String?
  companyId       String?
  createdAt       DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
}